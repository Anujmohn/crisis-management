# Frontend environment variables for Expo (React Native)
# Variables prefixed with EXPO_PUBLIC_ are bundled into the app and visible at runtime.
# Do NOT put secrets (API keys, passwords) in EXPO_PUBLIC_ variables.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Base URL of the FastAPI backend – no trailing slash.
#
# Android emulator (default AVD):
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#
# Physical Android or iOS device on the same LAN as your dev machine:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.XXX:8000
#
# iOS Simulator on macOS:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
#
# To find your LAN IP on Windows:  ipconfig | findstr "IPv4"
# To find your LAN IP on macOS:    ipconfig getifaddr en0

EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# ---------------------------------------------------------------------------
# Map configuration
# ---------------------------------------------------------------------------
# MapLibre style JSON URL.
# Defaults to OpenFreeMap "liberty" – no API key required.
# Attribution: © OpenFreeMap © OpenMapTiles Data © OpenStreetMap contributors
#
# To use MapTiler (free API key available at maptiler.com):
#   EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Override attribution text when using a different tile provider.
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenFreeMap © OpenMapTiles Data © OpenStreetMap contributors
