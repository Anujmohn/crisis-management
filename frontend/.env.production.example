# ==============================================================================
# Disaster Safety Mobile Application - Production Environment Template
# ==============================================================================
# Variables prefixed with EXPO_PUBLIC_ are bundled into the compiled application.
# NEVER PUT PRIVATE KEYS, SECRETS, OR PASSWORDS IN EXPO_PUBLIC_ VARIABLES.
# ==============================================================================

# Production Backend API Gateway (Must be HTTPS)
EXPO_PUBLIC_API_BASE_URL=https://api.disastersafety.in

# MapLibre Vector Tile Style URL
# OpenFreeMap Liberty style (Open, free, no API key required)
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Map Attribution
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenFreeMap © OpenMapTiles Data © OpenStreetMap contributors
