generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrisisType {
  EARTHQUAKE
  FLOOD
  RIOT
  FIRE
  MEDICAL
  OTHER
}

enum CrisisSessionStatus {
  ACTIVE
  ENDED
  ALERT_TRIGGERED
}

enum ContactChannel {
  SMS
  EMAIL
  BOTH
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  fullName        String?
  phoneNumber     String?  @unique // Store E.164 format, e.g. +14155552671.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trustedContacts TrustedContact[]
  crisisSessions  ActiveCrisisSession[]
}

model TrustedContact {
  id          String         @id @default(cuid())
  userId      String
  name        String
  phoneNumber String?        // E.164 format; required for SMS/BOTH.
  email       String?        // Required for EMAIL/BOTH.
  channel     ContactChannel @default(BOTH)
  priority    Int            @default(0) // Lower value = notify earlier.
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model ActiveCrisisSession {
  id                  String              @id @default(cuid())
  userId              String
  crisisType          CrisisType
  status              CrisisSessionStatus @default(ACTIVE)

  // Required last-known-position fields.
  last_location_lat   Decimal             @db.Decimal(9, 6)
  last_location_lng   Decimal             @db.Decimal(9, 6)
  last_ping_timestamp DateTime

  // Useful telemetry for reliability and auditability.
  locationAccuracyM   Float?
  lastPingSource      String?             // e.g. "gps", "network", "manual"
  startedAt           DateTime            @default(now())
  endedAt             DateTime?

  // Guarantees the watchdog only sends one automatic emergency alert.
  alertTriggeredAt    DateTime?
  alertReason         String?
  alertClaimToken     String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, last_ping_timestamp])
  @@index([userId, status])
}